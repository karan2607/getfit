SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
# Optional. GENERATION model; defaults to gemini-4-argon. Set to compare
# models without a code change; `manage.py eval_plans --live --model=...`
# scores candidates.
GEMINI_MODEL=

# Optional. CHAT model; defaults to gemini-2.5-flash, which is ~7x cheaper
# than the generation model. Separate because the eval scores 2.5-flash
# worst of five on plan generation but chat has no plan JSON to get wrong.
GEMINI_CHAT_MODEL=
RESEND_API_KEY=
FROM_EMAIL=GetFit <noreply@resend.dev>
SENTRY_DSN=

# Claude Haiku 5.5 drives the workout half of the chat agent.
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
